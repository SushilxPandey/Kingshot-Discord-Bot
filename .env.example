# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" — it holds secrets. (.gitignore already excludes it.)

# ── Required ──────────────────────────────────────────
# Your Discord bot token (Developer Portal → your app → Bot → Reset Token).
DISCORD_TOKEN=your-discord-bot-token-here

# Your Postgres connection string (e.g. from Neon).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Optional ──────────────────────────────────────────
# Set to a single server (guild) ID to sync slash commands there instantly while
# developing. Leave blank for normal global commands.
TEST_GUILD=

# Path to the profanity word list (defaults to badwords.txt next to the code).
BADWORDS_FILE=badwords.txt

# Override the stats-provider base URLs if you don't want them hardcoded.
# (These are public sites, not secrets — this is only for keeping them out of the repo.)
# KSTATS_BASE=https://kingshotstats.com/api
# KINGSHOT_NET_BASE=https://kingshot.net/api
